PORT=4000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nova

JWT_SECRET=

# URL của frontend (dùng để build link trong email đặt lại mật khẩu)
FRONTEND_URL=http://localhost:5173

# SMTP để gửi email thật (bỏ trống thì link đặt lại mật khẩu sẽ chỉ log ra console server)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NOVA <no-reply@nova.local>

# Google Identity Services — tạo tại https://console.cloud.google.com/apis/credentials
# (OAuth Client ID loại "Web application", Authorized JavaScript origin: http://localhost:5173)
GOOGLE_CLIENT_ID=

# Facebook Login — tạo tại https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
