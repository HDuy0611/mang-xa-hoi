# Đăng nhập Google (Google Identity Services) — tạo Client ID tại
# https://console.cloud.google.com/apis/credentials (loại "Web application",
# Authorized JavaScript origin: http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=

# Đăng nhập Facebook — tạo App ID tại https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=

# Kênh thông báo realtime: "signalr" khi chạy với backend C# (backend-c#)
VITE_REALTIME=signalr
